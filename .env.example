# --- Server ---
PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=dpboss
# Per-instance MongoDB pool cap (serverless-friendly default)
MONGO_MAX_POOL=10

# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Bootstrap admin, created only when the users collection is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy

# --- Upstream paid result API ---
# Leave blank to run on the bundled mock data.
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_SYNC_MS=300000
PROVIDER_TIMEOUT_MS=15000

# --- Vercel deployment ---
# Set every variable above in Project -> Settings -> Environment Variables
# (PORT is ignored there). Notes for Vercel:
#   * MONGO_URL must be a remote MongoDB (e.g. MongoDB Atlas free tier) -
#     localhost is not reachable from Vercel functions.
#   * NODE_ENV=production is set by Vercel automatically, which makes
#     JWT_SECRET mandatory (the API refuses to boot without it on purpose).
#   * ADMIN_USERNAME / ADMIN_PASSWORD seed the first super admin on the
#     first request - change that password right after the first login.
