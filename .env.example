# --- Server ---
PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=dpboss
# Per-instance MongoDB pool cap (serverless-friendly default)
MONGO_MAX_POOL=10

# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Bootstrap admin, created only when the users collection is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy

# --- Upstream paid result API ---
# Leave blank to run on the bundled mock data.
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_SYNC_MS=300000
PROVIDER_TIMEOUT_MS=15000

# --- Vercel deployment ---
# REQUIRED env vars in Project -> Settings -> Environment Variables:
#   MONGO_URL      remote MongoDB (Atlas free tier) - localhost is NOT
#                  reachable from Vercel functions
#   DB_NAME        e.g. dpboss
#   JWT_SECRET     long random string (mandatory in production)
#   ADMIN_USERNAME / ADMIN_PASSWORD  seed the first super admin on the first
#                  request - change that password right after the first login
# OPTIONAL overrides (code already defaults to the trial pair below):
#   MATKA_DOMAIN_KEY  default 5e3ccd445deac2c892fb84a7a9988340
#   MATKA_DOMAIN      default clone-git-main-ratan18.vercel.app
# (PORT is ignored on Vercel; NODE_ENV=production is set automatically.)

# --- Trial Matka API (matkaapi.com) ---
# Domain-locked: the upstream only answers when domain_key is sent together
# with the exact registered domain. No IP check.
# server/config.js already defaults to YOUR trial credentials
# (key 5e3c…8340 + clone-git-main-ratan18.vercel.app), so Vercel works right
# after `git push` with zero setup. Only set these env vars to override
# (e.g. when the trial is renewed or the domain changes):
#   https://www.matkaapi.com/mapi/market_api.php?market_list=1&domain_key=...&domain=...
MATKA_DOMAIN_KEY=
MATKA_DOMAIN=
MATKA_BASE_URL=https://www.matkaapi.com/mapi
MATKA_CACHE_MS=45000
MATKA_TIMEOUT_MS=15000
# How often completed draws are upserted into chart history (ms).
CHART_SYNC_MS=300000
